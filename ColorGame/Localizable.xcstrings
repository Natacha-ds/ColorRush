    "A color is called.\nTap " : {
      "comment" : "The first part of the home tagline (white). Followed by the cyan-accented 'anything else.' / 'la couleur annoncée.' tail. EN and FR phrase the rule from opposite angles (positive in EN: 'tap [anything else]', negative in FR: 'don't tap [the called color]') — both correct framings of the same gameplay rule.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A color is called.\nTap "
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une seule règle :\nne touche pas "
          }
        }
      }
    },
    "A color is called. Tap any square that's not that color." : {
      "comment" : "A description of the gameplay mechanic where players must tap non-matching squares.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A color is called. Tap any square that's not that color."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une couleur est annoncée. Tape sur n'importe quel carré qui n'est pas de cette couleur."
